{
  "name": "meridian-e2e",
  "private": true,
  "description": "Testes de fumaça end-to-end (somente dev). Fica em tests/e2e de propósito: não existe package.json na raiz, então a Vercel não instala nada disso.",
  "type": "module",
  "scripts": {
    "e2e": "node lib/run.mjs",
    "e2e:smoke": "node lib/run.mjs --grep @smoke",
    "e2e:headed": "node lib/run.mjs --headed --workers=1",
    "seed": "node fixtures/seed.mjs seed",
    "seed:clean": "node fixtures/seed.mjs clean",
    "tokens": "node fixtures/issue-tokens.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "dotenv": "^16.4.5",
    "pg": "^8.13.0"
  }
}
