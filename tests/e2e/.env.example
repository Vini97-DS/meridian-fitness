# Copie para tests/e2e/.env (ignorado pelo git). NUNCA commite valores reais.

# URL do app em TESTE: preview da Vercel ligado ao branch de teste do Neon, ou http://localhost:PORT.
# A suíte RECUSA rodar contra os domínios listados em config.json → "blockedHosts" ou com APP_ENV=production.
BASE_URL=
APP_ENV=test

# Sessões pré-emitidas do aluno e do profissional de TESTE (ver README: `npm run tokens`).
TEST_STUDENT_TOKEN=
TEST_PRO_TOKEN=

# Banco do branch de TESTE (seed + conferência de duplicidade). Precisa estar na allowlist.
DATABASE_URL=
TEST_DB_HOST_ALLOWLIST=
# Só para emitir os tokens (JWT_SECRET do ambiente de TESTE; nunca o de produção):
JWT_SECRET=
