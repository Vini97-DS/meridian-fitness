{
  "builds": [
    { "src": "api.py", "use": "@vercel/python" }
  ],
  "routes": [
    { "src": "/css/(.*)",    "dest": "/css/$1" },
    { "src": "/js/(.*)",     "dest": "/js/$1" },
    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/api/(.*)",    "dest": "api.py" },
    { "src": "/(.*)",        "dest": "api.py" }
  ]
}