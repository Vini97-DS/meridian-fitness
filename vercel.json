{
  "version": 2,
  "builds": [
    {
      "src": "api.py",
      "use": "@vercel/python"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "dashboard.html",
      "use": "@vercel/static"
    },
    {
      "src": "primeiro-acesso.html",
      "use": "@vercel/static"
    },
    {
      "src": "form.html",
      "use": "@vercel/static"
    },
    {
      "src": "css/**",
      "use": "@vercel/static"
    },
    {
      "src": "js/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "api.py" },
    { "src": "/form/(.*)", "dest": "api.py" },
    { "src": "/css/(.*)", "dest": "/css/$1" },
    { "src": "/js/(.*)",  "dest": "/js/$1"  },
    { "src": "/dashboard",       "dest": "/dashboard.html" },
    { "src": "/primeiro-acesso", "dest": "/primeiro-acesso.html" },
    { "src": "/",                "dest": "/index.html" }
  ]
}